{
  "schema_version": 1,
  "listen": "127.0.0.1:18317",
  "api_key_env": "COT_API_KEY",
  "admin_key_env": "COT_ADMIN_KEY",
  "runtime": {
    "max_inflight": 128,
    "max_queued": 128,
    "max_body_bytes": 16777216,
    "max_buffered_bytes": 134217728,
    "max_output_bytes": 67108864,
    "queue_timeout_ms": 5000,
    "request_timeout_ms": 300000,
    "write_timeout_ms": 15000,
    "body_read_timeout_ms": 15000
  },
  "browser": {
    "enabled": true,
    "cdp_url": "http://127.0.0.1:9222",
    "state_file": ".clash-tokens/sessions.json",
    "max_sessions": 256,
    "session_ttl_seconds": 86400,
    "poll_ms": 1000,
    "max_prompt_bytes": 65536,
    "max_response_bytes": 1048576
  },
  "sources": [
    {
      "id": "chatgpt-web",
      "provider": "chatgpt-web",
      "adapter": "chatgpt-web",
      "base_url": "https://chatgpt.com",
      "enabled": true,
      "auto_approved": false,
      "local": false,
      "paid": true,
      "max_inflight": 1,
      "quota_domain": "chatgpt-web-account",
      "quota_max_inflight": 1,
      "models": [
        {
          "id": "web",
          "upstream": "auto",
          "protocols": [
            "chat",
            "responses"
          ],
          "tier": "unrated",
          "rating_basis": "",
          "tools": "none",
          "vision": false,
          "max_input_bytes": 65536
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "auto",
      "type": "auto",
      "sources": [],
      "min_tier": "silver",
      "allow_unrated": false,
      "allow_paid": false,
      "local_only": false,
      "require_tools": false
    }
  ]
}
